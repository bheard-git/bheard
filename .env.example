# =========================
# App Environment Template
# =========================
# Copy this file to `.env` (local) or set these in your host panel.

# MongoDB connection string (Mongoose + Prisma)
# Use database name in the path (e.g. /bheard). If mongodb+srv fails on Windows
# with querySrv ECONNREFUSED, use the standard mongodb:// URI from Atlas Connect.
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/bheard?retryWrites=true&w=majority

# Admin panel login credentials (simple password gate)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Random secret used to sign admin session cookies
# Use a long random string (32+ chars recommended)
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Form notification recipients (comma-separated).
# Defaults to hello@bheard.in when unset. Lead form notifications only —
# career applications are database-only (no email).
LEAD_NOTIFICATION_TO=hello@bheard.in
# Fallback if LEAD_NOTIFICATION_TO is unset
# FORM_NOTIFICATION_TO=hello@bheard.in

# SMTP (preferred when set — e.g. Gmail, SendGrid SMTP, Microsoft 365 SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=BHEARD

# Microsoft Graph (used when SMTP_HOST is not set)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SENDER_EMAIL=
AZURE_SENDER_NAME=BHEARD

# Public site URL (canonical / emails / metadata)
NEXT_PUBLIC_SITE_URL=https://bheard.in

# Analytics and advertising
# Google Tag Manager container ID. Configure the GA4 tag inside this container.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
# Meta Pixel dataset/pixel ID (numbers only)
NEXT_PUBLIC_META_PIXEL_ID=

# Google reCAPTCHA v3 (lead + career forms) — https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Minimum score 0.0–1.0 (default 0.5). Lower = stricter bot blocking.
RECAPTCHA_MIN_SCORE=0.5
